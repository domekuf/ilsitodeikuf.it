---
// Superficie bianca con filetto sottile (niente ombre pesanti alla Material).
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & { as?: 'div' | 'article' | 'li' | 'section'; padded?: boolean };

const { as: Tag = 'div', padded = true, class: className, ...rest } = Astro.props;
---

<Tag class:list={['surface', padded && 'p-5 sm:p-6', className]} {...rest}>
  <slot />
</Tag>
