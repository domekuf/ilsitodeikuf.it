---
import Logo from '~/assets/logo/kuf-wordmark-compact.svg';
import { SITE } from '~/lib/site';

const year = new Date().getFullYear();
const links = SITE.nav.filter((i) => i.href !== '/');
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 pt-10 pb-28 sm:px-8 md:grid-cols-[auto_1fr] md:items-start md:gap-16 md:pb-12">
    <a href="/" class="text-ink" aria-label="Il Sito dei Kuf, vai alla home">
      <Logo aria-hidden="true" class="h-5 w-auto" />
    </a>
    <div class="flex flex-col gap-6">
      <nav aria-label="Secondaria">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[0.75rem] tracking-[0.16em] uppercase">
          {links.map((item) => (
            <li>
              <a href={item.href} data-modal-link={item.modal} class="hover:underline">
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/privacy" class="hover:underline">
              Privacy
            </a>
          </li>
        </ul>
      </nav>
      <p class="text-sm text-warm-ink">I brani dei Kuf non sono registrati alla SIAE e non lo saranno mai.</p>
      <p class="text-xs text-warm-ink">© {year} Kuf · Ravenna</p>
    </div>
  </div>
</footer>
