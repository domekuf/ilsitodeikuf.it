---
// /articoli e /articoli/[slug] (§7.5, §7.6): la lista e, all'accesso diretto, la modale già aperta.
// Dalla lista il dettaglio arriva da <template> già nella pagina: nessun fetch.
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Modal from '~/components/ui/Modal.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/lib/site';
import ArticleDetail from './ArticleDetail.astro';

interface Props {
  open?: CollectionEntry<'articoli'> | undefined;
}

const { open } = Astro.props;
const items = (await getCollection('articoli')).sort((a, b) => a.data.ordine - b.data.ordine);
const listTitle = `Articoli · ${SITE.name}`;
const detailTitle = (i: CollectionEntry<'articoli'>) => `${i.data.nome} · Articoli · ${SITE.name}`;
const og = open ? await getImage({ src: open.data.immagine, width: 1200, format: 'jpg' }) : undefined;
---

<BaseLayout
  title={open ? detailTitle(open) : listTitle}
  description={
    open
      ? `${open.data.nome}: una delle cose da avere dei Kuf.`
      : 'Le cose da avere dei Kuf: magliette e felpe.'
  }
  image={og ? new URL(og.src, Astro.site).href : undefined}
>
  <div class="mx-auto flex max-w-6xl flex-col gap-12 px-5 py-14 sm:px-8 sm:py-20">
    <SectionTitle level={1} title="Articoli" subtitle="Le cose da avere dei Kuf" />

    <ul class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-3">
      {items.map((item, i) => (
        <li class:list={[i > 1 && 'reveal']}>
          <a
            href={`/articoli/${item.id}`}
            data-modal-link="articolo"
            class="group surface flex h-full flex-col overflow-hidden transition-colors hover:border-ink/40"
          >
            <div class="relative overflow-hidden">
              <Image
                src={item.data.immagine}
                alt={item.data.alt}
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 360px, 50vw"
                loading={i < 2 ? 'eager' : 'lazy'}
                fetchpriority={i < 2 ? 'high' : 'auto'}
                class="aspect-[4/5] w-full object-cover transition-transform duration-300 ease-[var(--ease-soft)] group-hover:scale-[1.04]"
              />
              {!item.data.disponibile && (
                <span class="absolute top-3 left-3 rounded-[3px] bg-surface px-2 py-0.5 text-[0.6875rem] tracking-[0.18em] uppercase">
                  Finito
                </span>
              )}
            </div>
            <p class="flex-1 p-4 text-sm sm:text-base">{item.data.nome}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>

  {items.map((item) => (
    <template data-modal-template={`/articoli/${item.id}`} data-title={detailTitle(item)}>
      <ArticleDetail item={item} />
    </template>
  ))}

  <Modal slot="modals" id="articolo" size="lg" listUrl="/articoli" listTitle={listTitle} open={Boolean(open)}>
    {open && <ArticleDetail item={open} />}
  </Modal>
</BaseLayout>
