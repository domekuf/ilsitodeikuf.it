---
import '~/styles/global.css';
import { Font } from 'astro:assets';
import ContactModal from '~/components/layout/ContactModal.astro';
import Footer from '~/components/layout/Footer.astro';
import Header from '~/components/layout/Header.astro';
import MenuOverlay from '~/components/layout/MenuOverlay.astro';
import SocialDock from '~/components/social/SocialDock.astro';
import { DOCK_SEEN_SCRIPT } from '~/lib/inline-scripts.mjs';
import { SITE, cleanPath } from '~/lib/site';

interface Props {
  title?: string;
  description?: string;
  /** URL canonico, se diverso dalla pagina corrente (es. dettaglio aperto in modale) */
  canonical?: string;
  noindex?: boolean;
  /** /contattaci: la modale dei contatti arriva già aperta */
  contactOpen?: boolean;
  /** immagine Open Graph (URL assoluto) */
  image?: string | undefined;
}

const {
  title = SITE.name,
  description = `${SITE.name}, un gruppo di Ravenna che, a volte, fa la musica forte.`,
  canonical,
  noindex = false,
  contactOpen = false,
  image,
} = Astro.props;
const canonicalUrl = new URL(canonical ?? cleanPath(Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FBFAF7" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Font cssVariable="--font-montserrat" preload />
    <Font cssVariable="--font-inter" preload />
    <script is:inline set:html={DOCK_SEEN_SCRIPT} />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#contenuto"
      class="visually-hidden focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Salta al contenuto
    </a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
    <SocialDock />
    <MenuOverlay />
    <ContactModal open={contactOpen} />
    <slot name="modals" />
    <script>
      import { initForms } from '~/scripts/forms';
      import { initModalRouter } from '~/scripts/modal-router';
      initModalRouter();
      initForms();
    </script>
    {SITE.analyticsToken && (
      // Cloudflare Web Analytics: niente cookie, niente dati personali (ADR-062)
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: SITE.analyticsToken })}
      />
    )}
  </body>
</html>
